# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ao_server_data
DB_USER=postgres
DB_PASSWORD=your_password_here


# ao_data_to_sql (parser) settings

# On resource-constrained servers (e.g., shared hosting with your game server),
# you can lower THREADS and BATCH_SIZE to reduce CPU and RAM usage.
# This increases execution time but avoids impacting other processes.
BATCH_SIZE=100    # Records per database batch insert
THREADS=0         # Thread pool size (0 = auto-detect CPU cores)
CHARFILE_DIR=/path/to/Charfile # Absolute path
DATS_DIR=/path/to/dat # Absolute path
MAPS_DIR=/path/to/Maps # Absolute path
SERVER_INI_PATH=/path/to/Server.ini # Absolute path. The Server.ini file is typically located in the same directory as the server.exe
STRIP_DAT_INLINE_COMMENTS=true # Remove inline comments from .dat fields. Section header comments remain intact though
# Performance profiling (optional)
ENABLE_PROFILING=false    # Enable CPU/RAM monitoring


# ao_sql_to_static_files (json-gen) settings

RANKING_LIMIT=50 # Maximum number of entries per ranking
WRITE_TO_DISK=false # Write JSON files to disk (for testing/debugging only)
STATIC_JSON_OUTPUT_DIR=./ao_sql_to_static_files/exported-json # Output directory when WRITE_TO_DISK=true
# Cloudflare R2 CDN settings
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
