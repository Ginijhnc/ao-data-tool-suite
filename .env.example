# Database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ao_server_data
DB_USER=postgres
DB_PASSWORD=your_password_here

# Parser settings
# On resource-constrained servers (e.g., shared hosting with your game server),
# you can lower THREADS and BATCH_SIZE to reduce CPU and RAM usage.
# This increases execution time but avoids impacting other processes.
BATCH_SIZE=100    # Records per database batch insert
THREADS=0         # Thread pool size (0 = auto-detect CPU cores)
CHARFILE_DIR=/path/to/Charfile # Absolute path

# Performance profiling (optional)
ENABLE_PROFILING=false    # Enable CPU/RAM monitoring
